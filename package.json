{
	"name": "aixcoding",
	"displayName": "AIxCoding",
	"description": "一个基于大模型的智能编码VS Code插件",
	"publisher": "bocsoft",
	"version": "3.1.0-alpha",
	"enabledApiProposals": [
		"extensionsAny",
		"newSymbolNamesProvider",
		"interactive",
		"codeActionAI",
		"activeComment",
		"commentReveal",
		"contribCommentThreadAdditionalMenu",
		"contribCommentsViewThreadMenus",
		"documentFiltersExclusive",
		"embeddings",
		"findTextInFiles",
		"findTextInFiles2",
		"findFiles2@2",
		"textSearchProvider",
		"terminalDataWriteEvent",
		"terminalExecuteCommandEvent",
		"terminalSelection",
		"terminalQuickFixProvider",
		"mappedEditsProvider",
		"aiRelatedInformation",
		"aiSettingsSearch",
		"chatParticipantAdditions",
		"chatEditing",
		"defaultChatParticipant@4",
		"contribSourceControlInputBoxMenu",
		"authLearnMore",
		"testObserver",
		"aiTextSearchProvider@2",
		"chatParticipantPrivate@9",
		"chatProvider",
		"contribDebugCreateConfiguration",
		"chatReferenceDiagnostic",
		"textSearchProvider2",
		"chatReferenceBinaryData",
		"languageModelSystem",
		"languageModelCapabilities",
		"inlineCompletionsAdditions",
		"languageModelDataPart@3",
		"chatStatusItem",
		"taskProblemMatcherStatus",
		"contribLanguageModelToolSets",
		"textDocumentChangeReason",
		"resolvers",
		"taskExecutionTerminal",
		"dataChannels"
	],
	"icon": "assets/icons/logo.png",
	"galleryBanner": {
		"color": "#617A91",
		"theme": "dark"
	},
	"engines": {
		"vscode": "^1.92.0"
	},
	"author": {
		"name": "bocsoft"
	},
	"homepage": "http://22.189.54.139",
	"categories": [
		"AI",
		"Chat",
		"Programming Languages",
		"Education",
		"Snippets",
		"Testing"
	],
	"keywords": [
		"dev",
		"mcp",
		"coding",
		"agent",
		"ai",
		"AIxCoding"
	],
	"activationEvents": [
		"onLanguage",
		"onStartupFinished"
	],
	"main": "./dist/extension.js",
	"contributes": {
		"viewsContainers": {
			"activitybar": [
				{
					"id": "aixcoding-ActivityBar",
					"title": "AIxCoding",
					"icon": "assets/icons/logo.png"
				}
			]
		},
		"views": {
			"aixcoding-ActivityBar": [
				{
					"type": "webview",
					"id": "aixcoding.SidebarProvider",
					"name": ""
				}
			]
		},
		"commands": [
			{
				"command": "aixcoding.plusButtonClicked",
				"title": "新建任务",
				"icon": "$(add)"
			},
			{
				"command": "aixcoding.promptsButtonClicked",
				"title": "提示",
				"icon": "$(notebook)"
			},
			{
				"command": "aixcoding.mcpButtonClicked",
				"title": "MCP 服务器",
				"icon": "$(server)"
			},
			{
				"command": "aixcoding.historyButtonClicked",
				"title": "历史记录",
				"icon": "$(history)"
			},
			{
				"command": "aixcoding.settingsButtonClicked",
				"title": "设置",
				"icon": "$(settings-gear)"
			},
			{
				"command": "aixcoding.helpButtonClicked",
				"title": "文档",
				"icon": "$(question)"
			},
			{
				"command": "aixcoding.openInNewTab",
				"title": "在新标签页中打开",
				"category": "AIxCoding"
			},
			{
				"command": "aixcoding.explainCode",
				"title": "AIxCoding: 解释代码",
				"category": "AIxCoding"
			},
			{
				"command": "aixcoding.fixCode",
				"title": "AIxCoding: 修复代码",
				"category": "AIxCoding"
			},
			{
				"command": "aixcoding.improveCode",
				"title": "AIxCoding: 改进代码",
				"category": "AIxCoding"
			},
			{
				"command": "aixcoding.addToContext",
				"title": "AIxCoding: 添加到上下文",
				"category": "AIxCoding"
			},
			{
				"command": "aixcoding.checkCode",
				"title": "AIxCoding: 检查代码",
				"category": "AIxCoding"
			},
			{
				"command": "aixcoding.addComments",
				"title": "AIxCoding: 生成注释",
				"category": "AIxCoding"
			},
			{
				"command": "aixcoding.addTest",
				"title": "AIxCoding: 编写测试",
				"category": "AIxCoding"
			},
			{
				"command": "aixcoding.terminalAddToContext",
				"title": "AIxCoding: 将终端内容添加到上下文",
				"category": "Terminal"
			},
			{
				"command": "aixcoding.terminalFixCommand",
				"title": "AIxCoding: 修复此命令",
				"category": "Terminal"
			},
			{
				"command": "aixcoding.terminalExplainCommand",
				"title": "AIxCoding: 解释此命令",
				"category": "Terminal"
			},
			{
				"command": "aixcoding.terminalFixCommandInCurrentTask",
				"title": "AIxCoding: 修复此命令 (当前任务)",
				"category": "Terminal"
			},
			{
				"command": "aixcoding.terminalExplainCommandInCurrentTask",
				"title": "AIxCoding: 解释此命令 (当前任务)",
				"category": "Terminal"
			},
			{
				"command": "aixcoding.stopCompletion",
				"title": "停止补全"
			},
			{
				"command": "aixcoding.lintProject",
				"title": "扫描工程"
			},
			{
				"command": "aixcoding.lintSelected",
				"title": "扫描选中文件"
			},
			{
				"command": "aixcoding.lintCurrent",
				"title": "扫描当前文件"
			},
			{
				"command": "aixcoding.clearDiagnostics",
				"title": "清空问题"
			},
			{
				"command": "aixcoding.gitVersionCompare",
				"title": "执行git版本比较"
			}
		],
		"menus": {
			"AIxCodingTool": [
				{
					"command": "aixcoding.lintProject",
					"group": "AIxCodingLint@1"
				},
				{
					"command": "aixcoding.lintSelected",
					"group": "AIxCodingLint@2"
				},
				{
					"command": "aixcoding.lintCurrent",
					"group": "AIxCodingLint@3"
				},
				{
					"command": "aixcoding.clearDiagnostics",
					"group": "AIxCodingLint@4"
				},
				{
					"command": "aixcoding.gitVersionCompare",
					"group": "AIxCodingLintConfig@1"
				}
			],
			"explorer/context": [
				{
					"group": "AIxCodingLint@1",
					"submenu": "AIxCodingTool",
					"when": "explorerViewletVisible"
				}
			],
			"editor/context": [
				{
					"command": "aixcoding.explainCode",
					"when": "editorHasSelection",
					"group": "AIxCoding@1"
				},
				{
					"command": "aixcoding.fixCode",
					"when": "editorHasSelection",
					"group": "AIxCoding@2"
				},
				{
					"command": "aixcoding.improveCode",
					"when": "editorHasSelection",
					"group": "AIxCoding@3"
				},
				{
					"command": "aixcoding.addToContext",
					"when": "editorHasSelection",
					"group": "AIxCoding@4"
				}
			],
			"terminal/context": [
				{
					"command": "aixcoding.terminalAddToContext",
					"group": "AIxCoding@1"
				},
				{
					"command": "aixcoding.terminalFixCommand",
					"group": "AIxCoding@2"
				},
				{
					"command": "aixcoding.terminalExplainCommand",
					"group": "AIxCoding@3"
				},
				{
					"command": "aixcoding.terminalFixCommandInCurrentTask",
					"group": "AIxCoding@5"
				},
				{
					"command": "aixcoding.terminalExplainCommandInCurrentTask",
					"group": "AIxCoding@6"
				}
			],
			"view/title": [
				{
					"command": "aixcoding.plusButtonClicked",
					"group": "navigation@1",
					"when": "view == aixcoding.SidebarProvider"
				},
				{
					"command": "aixcoding.promptsButtonClicked",
					"group": "navigation@2",
					"when": "view == aixcoding.SidebarProvider"
				},
				{
					"command": "aixcoding.mcpButtonClicked",
					"group": "navigation@3",
					"when": "view == aixcoding.SidebarProvider"
				},
				{
					"command": "aixcoding.historyButtonClicked",
					"group": "navigation@4",
					"when": "view == aixcoding.SidebarProvider"
				},
				{
					"command": "aixcoding.settingsButtonClicked",
					"group": "navigation@6",
					"when": "view == aixcoding.SidebarProvider"
				},
				{
					"command": "aixcoding.helpButtonClicked",
					"group": "navigation@8",
					"when": "view == aixcoding.SidebarProvider"
				}
			]
		},
		"submenus": [
			{
				"id": "AIxCodingTool",
				"label": "AIxCoding代码扫描"
			}
		],
		"configuration": {
			"title": "AIxCoding",
			"properties": {
				"aixcoding.allowedCommands": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						"npm test",
						"npm install",
						"tsc",
						"git log",
						"git diff",
						"git show"
					],
					"description": "Commands that can be auto-executed when 'Always approve execute operations' is enabled"
				},
				"aixcoding.vsCodeLmModelSelector": {
					"type": "object",
					"properties": {
						"vendor": {
							"type": "string",
							"description": "The vendor of the language model (e.g. copilot)"
						},
						"family": {
							"type": "string",
							"description": "The family of the language model (e.g. gpt-4)"
						}
					},
					"description": "Settings for VSCode Language Model API"
				}
			}
		}
	},
	"scripts": {
		"build": "npm run build:webview && npm run vsix",
		"build:webview": "cd webview-ui && npm run build",
		"changeset": "changeset",
		"check-types": "tsc --noEmit",
		"compile": "tsc -p . --outDir out && node esbuild.js",
		"compile:integration": "tsc -p tsconfig.integration.json",
		"install:all": "npm install && cd webview-ui && npm install",
		"lint": "eslint src --ext ts && npm run lint --prefix webview-ui",
		"lint-fix": "eslint src --ext ts --fix && npm run lint-fix --prefix webview-ui",
		"package": "npm run build:webview && npm run check-types && npm run lint && node esbuild.js --production",
		"pretest": "npm run compile && npm run compile:integration",
		"dev": "cd webview-ui && npm run dev",
		"test": "jest && npm run test:webview",
		"test:webview": "cd webview-ui && npm run test",
		"test:integration": "npm run build && npm run compile:integration && npx dotenvx run -f .env.integration -- node ./out-integration/test/runTest.js",
		"prepare": "husky",
		"publish:marketplace": "vsce publish && ovsx publish",
		"publish": "npm run build && changeset publish && npm install --package-lock-only",
		"version-packages": "changeset version && npm install --package-lock-only",
		"vscode:prepublish": "npm run package",
		"vsix": "rimraf bin && mkdirp bin && npx vsce package --out bin",
		"watch": "npm-run-all -p watch:*",
		"watch:esbuild": "node esbuild.js --watch",
		"watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
		"watch-tests": "tsc -p . -w --outDir out",
		"postinstall": "node scripts/postinstall.mjs"
	},
	"dependencies": {
		"@anthropic-ai/bedrock-sdk": "^0.10.2",
		"@anthropic-ai/sdk": "^0.26.0",
		"@anthropic-ai/vertex-sdk": "^0.4.1",
		"@aws-sdk/client-bedrock-runtime": "^3.706.0",
		"@google/generative-ai": "^0.18.0",
		"@microsoft/tiktokenizer": "^1.0.0",
		"@mistralai/mistralai": "^1.3.6",
		"@modelcontextprotocol/sdk": "^1.0.1",
		"@types/clone-deep": "^4.0.4",
		"@types/pdf-parse": "^1.1.4",
		"@types/react": "^19.0.10",
		"@types/tmp": "^0.2.6",
		"@types/turndown": "^5.0.5",
		"@types/vscode": "^1.102.0",
		"@vscode/codicons": "^0.0.36",
		"@vscode/copilot-api": "^0.1.3",
		"@vscode/l10n": "^0.0.1",
		"@vscode/prompt-tsx": "^0.4.0-alpha.5",
		"async-lock": "^1.4.1",
		"axios": "^1.7.4",
		"cheerio": "^1.0.0",
		"chokidar": "^4.0.1",
		"clone-deep": "^4.0.1",
		"default-shell": "^2.2.0",
		"delay": "^6.0.0",
		"diff": "^5.2.0",
		"diff-match-patch": "^1.0.5",
		"eslint-plugin-vue": "^10.0.0",
		"eslint-visitor-keys": "^4.2.0",
		"espree": "^10.3.0",
		"fast-deep-equal": "^3.1.3",
		"fastest-levenshtein": "^1.0.16",
		"get-folder-size": "^5.0.0",
		"globby": "^14.0.2",
		"handlebars": "^4.7.8",
		"isbinaryfile": "^5.0.2",
		"js-tiktoken": "^1.0.20",
		"lodash": "^4.17.21",
		"lru-cache": "^11.1.0",
		"mammoth": "^1.8.0",
		"markdown-it": "^14.1.0",
		"monaco-editor": "^0.50.0",
		"monaco-vscode-textmate-theme-converter": "^0.1.7",
		"ncp": "^2.0.0",
		"openai": "^4.78.1",
		"os-name": "^6.0.0",
		"p-wait-for": "^5.0.2",
		"pdf-parse": "^1.1.1",
		"picomatch": "^4.0.2",
		"pretty-bytes": "^6.1.1",
		"puppeteer-chromium-resolver": "^23.0.0",
